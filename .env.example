# ============================================================
# Telegram Cloud Storage — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Database -----------------------------------------------
# PostgreSQL connection string
# Local example: postgresql://postgres:password@localhost:5432/telecloud
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# ---- Session ------------------------------------------------
# Random secret for iron-session cookie encryption (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_32_CHAR_RANDOM_SECRET"
SESSION_COOKIE_NAME="telecloud_session"

# ---- Telegram -----------------------------------------------
# Your Telegram bot token (from @BotFather). NEVER expose in client code.
TELEGRAM_BOT_TOKEN="1234567890:AAABBBCCCDDDEEEFFFGGGHHH"

# The chat ID of your private Telegram channel/group used as storage.
# Must be a numeric ID, e.g. -1001234567890 for supergroups/channels.
TELEGRAM_CHAT_ID="-1001234567890"

# ---- Storage Adapter ----------------------------------------
# Use "telegram" in production, "mock" for local dev without Telegram creds
STORAGE_ADAPTER="mock"

# ---- Quotas -------------------------------------------------
# Default per-user storage quota in bytes (default: 1 GB)
DEFAULT_QUOTA_BYTES="1073741824"

# Max file size per upload in bytes (Telegram Bot API hard limit: 50 MB)
MAX_FILE_SIZE_BYTES="52428800"

# ---- App ----------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
